# Always fetch the latest page so a new deploy shows up immediately
<IfModule mod_headers.c>
  <FilesMatch "\.(html|json|webmanifest)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  # Built JS/CSS have a content hash in their name, so they can be cached for a long time
  <FilesMatch "^index-[A-Za-z0-9_-]+\.(js|css)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
